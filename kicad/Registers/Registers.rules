
(rules PCB Registers
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 170048)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.5)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.7)
    )
  )
  (rule
    (width 250.0)
    (clear 200.2)
    (clear 125.0 (type smd_to_turn_gap))
    (clear 50.0 (type smd_smd))
  )
  (padstack "Via[0-1]_800:400_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-1]_1000:500_um"
    (shape
      (circle F.Cu 1000.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 1000.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_800:400_um" "Via[0-1]_800:400_um" default
  )
  (via 
    "Via[0-1]_1000:500_um" "Via[0-1]_1000:500_um" default
  )
  (via 
    "Via[0-1]_800:400_um-kicad_default" "Via[0-1]_800:400_um" "kicad_default"
  )
  (via 
    "Via[0-1]_1000:500_um-kicad_default" "Via[0-1]_1000:500_um" "kicad_default"
  )
  (via 
    "Via[0-1]_800:400_um-Power" "Via[0-1]_800:400_um" Power
  )
  (via 
    "Via[0-1]_1000:500_um-Power" "Via[0-1]_1000:500_um" Power
  )
  (via_rule
    default "Via[0-1]_800:400_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_800:400_um-kicad_default"
  )
  (via_rule
    Power "Via[0-1]_1000:500_um-Power"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "unconnected-(J1-Pin_a2-Pada2)" "/*PI_ENABLE" "/*MEMM_ENABLE" "/*PROT_ENABLE" "/*DMA_REQ" "/*CHAN_REQ" "/*DEV_REQ" "/*INT_REQ"
    "/*IOT_SKIP" "/*IOT_WAIT" "/*IOT_SKIP_L" "/*LATCH_IR" "/*LATCH_MA" "/*LATCH_PC" "/*LATCH_AC" "/*LATCH_STEP"
    "/*LATCH_MQ" "/*LATCH_MB" "/*LATCH_WRTBK" "/*LATCH_OB" "/*WRITE_CORE" "/SELECT_PCMA" /ALUO0 /ALUO1
    /ALUO2 /LINKS0 /LINKS1 "/ALU_SHIFT" "/ALU_ONES" "unconnected-(J1-Pin_a31-Pada31)" "unconnected-(J1-Pin_b2-Padb2)" "/STEP_ZERO"
    "/FLAG_ZERO" "/FLAG_SIGN" "/FLAG_LINK" "/FLAG_LINK_INIT" "/FLAG_AC_SIGN" "/BUS_SELECT0" "/BUS_SELECT1" "/BUS_SELECT2"
    "/*SELECT_AC" "/*SELECT_STEP" "/*SELECT_MQ" "/*SELECT_CROSS" "/*SELECT_ALU" "/*SELECT_CORE" "/*SELECT_SWR" "/*SELECT_EXTRN"
    "/*IOT_PULSE" "/*DRQ_GRANT" "/REQ_ADDR" "/*JMP_I_DETECT" "/*INT_DETECT" "/*READ_IN_PULSE" /HALT "/ADDR_MODE0"
    "/ADDR_MODE1" "/CTL_CONST" /EXTRA0 "unconnected-(J1-Pin_b31-Padb31)" "unconnected-(J2-Pin_a2-Pada2)" /D0 /D1 /D2
    /D3 /D4 /D5 /D6 /D7 /D8 /D9 /D10
    /D11 /D12 /D13 /D14 /D15 /D16 /D17 /*RESET
    /*CAF /CLK /EXTRA1 /EXTRA3 /EXTRA5 "/NEXT_BANK0" "/*REST_PEND" /FP0
    /FP2 "unconnected-(J2-Pin_a31-Pada31)" "unconnected-(J2-Pin_b2-Padb2)" /A0 /A1 /A2 /A3 /A4
    /A5 /A6 /A7 /A8 /A9 /A10 /A11 /A12
    /A13 /A14 /SC0 /SC1 /SC2 /SC3 /SC4 /SC5
    /EXTRA2 /EXTRA4 /EXTRA6 "/NEXT_BANK1" "/MA_AUTO_INX" /FP1 /FP3 "unconnected-(J2-Pin_b31-Padb31)"
    "Net-(U19-U{slash}~{D})" "Net-(U20-U{slash}~{D})" "Net-(U1-OEa)" /CB0 /MQ0 /AC0 /AC1 /MQ1
    /CB1 /CB2 /MQ2 /AC2 /AC3 /MQ3 /CB3 /CB4
    /MQ4 /AC4 /AC5 /MQ5 /CB5 /CB6 /MQ6 /AC6
    /AC7 /MQ7 /CB7 /CB8 /MQ8 /AC8 /AC9 /MQ9
    /CB9 "Net-(U6-OEa)" /CB10 /MQ10 /AC10 /AC11 /MQ11 /CB11
    /CB12 /MQ12 /AC12 /AC13 /MQ13 /MQ14 /AC14 /AC15
    /MQ15 "Net-(U8-I3b)" "Net-(U9-I3a)" /MQ16 /AC16 /AC17 /MQ17 /DB7
    /DB6 /DB5 /DB4 /DB3 /DB2 /DB1 /DB0 /DB15
    /DB14 /DB13 /DB12 /DB11 /DB10 /DB9 /DB8 "unconnected-(U12-O3b-Pad3)"
    "unconnected-(U12-O2b-Pad5)" "unconnected-(U12-O1b-Pad7)" "unconnected-(U12-O0b-Pad9)" "unconnected-(U12-O3a-Pad12)" "unconnected-(U12-O2a-Pad14)" /DB17 /DB16 "unconnected-(U15-Q2-Pad6)"
    "unconnected-(U15-Q3-Pad9)" "unconnected-(U15-Q4-Pad12)" "unconnected-(U15-Q5-Pad15)" "unconnected-(U15-Q6-Pad16)" "unconnected-(U15-Q7-Pad19)" "unconnected-(U18-Q2-Pad6)" "unconnected-(U18-Q3-Pad9)" "unconnected-(U18-Q4-Pad12)"
    "unconnected-(U18-Q5-Pad15)" "unconnected-(U18-Q6-Pad16)" "unconnected-(U18-Q7-Pad19)" "Net-(U19-~{PE})" "Net-(U19-~{TC})" "unconnected-(U20-Q3-Pad11)" "unconnected-(U20-Q2-Pad12)" "unconnected-(U20-~{TC}-Pad15)"
    "Net-(U21-C4)" "Net-(U22-C4)" "Net-(U23-C4)" "unconnected-(U24-S2-Pad1)" "unconnected-(U24-C4-Pad9)" "unconnected-(U24-S4-Pad10)" "unconnected-(U24-S3-Pad13)" "Net-(U25-Pad12)"
    "Net-(U25-Pad13)" "Net-(U25-Pad8)" "Net-(U25-Pad11)" "unconnected-(U26-Pad13)" "unconnected-(U27-Pad11)"
    (clearance_class "kicad_default")
    (via_rule kicad_default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class Power
    +5V GND
    (clearance_class Power)
    (via_rule Power)
    (rule
      (width 500.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)