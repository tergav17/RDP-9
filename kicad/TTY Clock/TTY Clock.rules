    "/*SET_RTC_EN" "Net-(U31B-~{R})" "/RTC_FLAG" "Net-(U3-Pad5)" "Net-(U10-Pad13)" "/*A_PULSE12" "Net-(U10-Pad3)" "Net-(U20-Pad1)"
    "/MEMM_ENABLE" "/*RTC_EN" "/KEYBD_SKIP" "/*PRINT_EN" "/PRINT_SKIP" "/*API_EN" "Net-(U10-Pad5)" "/*PI_SET"
    "/*KEYBD_RD" "/*PRINT_RES" "/*RTC_ENABLE" "/*RTC_FLAG" "/*TRNS_FLAG_0" "unconnected-(U8-O6-Pad9)" "unconnected-(U8-O5-Pad10)" "Net-(U8-O4)"
