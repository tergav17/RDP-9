
(rules PCB Front Panel Address
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 5467)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.6)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.6)
    )
  )
  (rule
    (width 250.0)
    (clear 200.2)
    (clear 125.0 (type smd_to_turn_gap))
    (clear 50.0 (type smd_smd))
  )
  (padstack "Via[0-1]_800:400_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-1]_1000:500_um"
    (shape
      (circle F.Cu 1000.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 1000.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_800:400_um" "Via[0-1]_800:400_um" default
  )
  (via 
    "Via[0-1]_1000:500_um" "Via[0-1]_1000:500_um" default
  )
  (via 
    "Via[0-1]_800:400_um-kicad_default" "Via[0-1]_800:400_um" "kicad_default"
  )
  (via 
    "Via[0-1]_1000:500_um-kicad_default" "Via[0-1]_1000:500_um" "kicad_default"
  )
  (via 
    "Via[0-1]_800:400_um-Power" "Via[0-1]_800:400_um" Power
  )
  (via 
    "Via[0-1]_1000:500_um-Power" "Via[0-1]_1000:500_um" Power
  )
  (via_rule
    default "Via[0-1]_800:400_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_800:400_um-kicad_default"
  )
  (via_rule
    Power "Via[0-1]_1000:500_um-Power"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "Net-(U4-CV)" "Net-(U4-THR)" "Net-(D1-K)" "Net-(D1-A)" "Net-(D2-K)" "Net-(D2-A)" "Net-(D3-K)" "Net-(D3-A)"
    "Net-(D4-K)" "Net-(D4-A)" "Net-(D5-K)" "Net-(D5-A)" "Net-(D6-K)" "Net-(D6-A)" "Net-(D7-K)" "Net-(D7-A)"
    "Net-(D8-K)" "Net-(D8-A)" "Net-(D9-K)" "Net-(D9-A)" "Net-(D10-K)" "Net-(D10-A)" "Net-(D11-K)" "Net-(D11-A)"
    "Net-(D12-K)" "Net-(D12-A)" "Net-(D13-K)" "Net-(D13-A)" "Net-(D14-K)" "Net-(D14-A)" "Net-(D15-K)" "Net-(D15-A)"
    "Net-(D16-K)" "Net-(D16-A)" "Net-(D17-K)" "Net-(D17-A)" "Net-(D18-K)" "Net-(D18-A)" "Net-(D19-K)" "Net-(D19-A)"
    "Net-(D20-K)" "Net-(D20-A)" "Net-(D21-K)" "Net-(D21-A)" "Net-(D22-K)" "Net-(D22-A)" "Net-(D23-K)" "Net-(D23-A)"
    "Net-(D24-K)" "Net-(D24-A)" "Net-(D25-K)" "Net-(D25-A)" "Net-(D26-K)" "Net-(D26-A)" "Net-(D27-K)" "Net-(D27-A)"
    "Net-(D28-K)" "Net-(D28-A)" "Net-(D29-K)" "Net-(D29-A)" "Net-(D30-K)" "Net-(D30-A)" "Net-(D31-K)" "Net-(D31-A)"
    "Net-(D32-K)" "Net-(D32-A)" "Net-(D33-K)" "Net-(D33-A)" "Net-(D34-K)" "Net-(D34-A)" "Net-(D35-K)" "Net-(D35-A)"
    "Net-(D36-K)" "Net-(D36-A)" "Net-(D37-K)" "Net-(D37-A)" "Net-(D38-K)" "Net-(D38-A)" "Net-(D39-K)" "Net-(D39-A)"
    "Net-(D40-K)" "Net-(D40-A)" "Net-(D41-K)" "Net-(D41-A)" "Net-(D42-K)" "Net-(D42-A)" "Net-(D43-K)" "Net-(D43-A)"
    "Net-(D44-K)" "Net-(D44-A)" "Net-(D45-K)" "Net-(D45-A)" /D0 /D1 /D2 /D3
    /D4 /D5 /D6 /D7 /D8 /D9 /D10 /D11
    /D12 /D13 /D14 /D15 /D16 /D17 /FP0 /FP1
    /FP2 /FP3 "/*SELECT_SWR" "/CLK_B" "/CLK_A" "/*LATCH_MQ" "/*LATCH_AC" "/*LATCH_MB"
    "/*LATCH_IR" "/*LATCH_PC" "/*LATCH_MA" /SC5 /SC4 /SC3 /SC2 /SC1
    /SC0 "/*MEMM_ENABLE" /HALT "/*PI_ENABLE" "/FLAG_LINK" "/NEXT_BANK1" "/NEXT_BANK0" "Net-(U3A-~{S})"
    "Net-(U3A-~{R})" "Net-(U3B-~{S})" "Net-(U3B-~{R})" "Net-(U4-DIS)" "Net-(SW1-B)" "Net-(SW2-B)" "Net-(SW3-B)" "Net-(SW4-B)"
    "Net-(SW5-B)" "Net-(SW6-B)" "Net-(SW7-B)" "Net-(SW8-B)" "Net-(SW9-B)" "unconnected-(SW1-A-Pad1)" "unconnected-(SW2-A-Pad1)" "unconnected-(SW3-A-Pad1)"
    "unconnected-(SW4-A-Pad1)" "unconnected-(SW5-A-Pad1)" "unconnected-(SW6-A-Pad1)" "unconnected-(SW7-A-Pad1)" "unconnected-(SW8-A-Pad1)" "unconnected-(SW9-A-Pad1)" "Net-(U1-Q0)" "Net-(U1-Q1)"
    "Net-(U1-Q2)" "Net-(U1-Q3)" "Net-(U1-Q4)" "Net-(U1-Q5)" "Net-(U1-Q6)" "Net-(U1-Q7)" "Net-(U2-E9)" "unconnected-(U2-N{slash}C-Pad15)"
    "unconnected-(U3A-~{Q}-Pad6)" "unconnected-(U3B-~{Q}-Pad8)" "unconnected-(U5-Pad8)" "unconnected-(U5-Pad10)" "unconnected-(U5-Pad12)" "unconnected-(U6-O3b-Pad3)" "unconnected-(U7-Q5-Pad15)" "unconnected-(U7-Q6-Pad16)"
    "unconnected-(U7-Q7-Pad19)" "unconnected-(U8-Q7-Pad19)" "unconnected-(U11-Q7-Pad19)" "/SYNC_CLK" "Net-(U3B-D)" "/DELAY_CLK"
    (clearance_class "kicad_default")
    (via_rule kicad_default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class Power
    GND +5V
    (clearance_class Power)
    (via_rule Power)
    (rule
      (width 500.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)