
(rules PCB ALU
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 41459)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.5)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.7)
    )
  )
  (rule
    (width 250.0)
    (clear 200.2)
    (clear 125.0 (type smd_to_turn_gap))
    (clear 50.0 (type smd_smd))
  )
  (padstack "Via[0-1]_800:400_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-1]_1000:500_um"
    (shape
      (circle F.Cu 1000.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 1000.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_800:400_um" "Via[0-1]_800:400_um" default
  )
  (via 
    "Via[0-1]_1000:500_um" "Via[0-1]_1000:500_um" default
  )
  (via 
    "Via[0-1]_800:400_um-kicad_default" "Via[0-1]_800:400_um" "kicad_default"
  )
  (via 
    "Via[0-1]_1000:500_um-kicad_default" "Via[0-1]_1000:500_um" "kicad_default"
  )
  (via 
    "Via[0-1]_800:400_um-Power" "Via[0-1]_800:400_um" Power
  )
  (via 
    "Via[0-1]_1000:500_um-Power" "Via[0-1]_1000:500_um" Power
  )
  (via_rule
    default "Via[0-1]_800:400_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_800:400_um-kicad_default"
  )
  (via_rule
    Power "Via[0-1]_1000:500_um-Power"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "unconnected-(J1-Pin_a2-Pada2)" "/*PI_ENABLE" "/*MEMM_ENABLE" "/*PROT_ENABLE" "/*DMA_REQ" "/*CHAN_REQ" "/*DEV_REQ" "/*INT_REQ"
    "/*IOT_SKIP" "/*IOT_WAIT" "/*IOT_SKIP_L" "/*LATCH_IR" "/*LATCH_MA" "/*LATCH_PC" "/*LATCH_AC" "/*LATCH_STEP"
    "/*LATCH_MQ" "/*LATCH_MB" "/*LATCH_WRTBK" "/*LATCH_OB" "/*WRITE_CORE" "/SELECT_PCMA" /ALUO0 /ALUO1
    /ALUO2 /LINKS0 /LINKS1 "/ALU_SHIFT" "/ALU_ONES" "unconnected-(J1-Pin_a31-Pada31)" "unconnected-(J2-Pin_a2-Pada2)" /D0
    /D1 /D2 /D3 /D4 /D5 /D6 /D7 /D8
    /D9 /D10 /D11 /D12 /D13 /D14 /D15 /D16
    /D17 /*RESET /*CAF /CLK /EXTRA1 /EXTRA3 /EXTRA5 "/NEXT_BANK0"
    "/*REST_PEND" /FP0 /FP2 "unconnected-(J2-Pin_a31-Pada31)" "Net-(R1-Pad2)" "Net-(U38-I1d)" /OB0 /OB1
    /OB2 /OB3 /OB4 /OB5 /OB6 /OB7 /OB8 /OB9
    /OB10 /OB11 /OB12 /OB13 /OB14 /OB15 /OB16 /OB17
    "/FLAG_LINK" "Net-(U3-D2)" "unconnected-(U3-Q3-Pad9)" "unconnected-(U3-Q4-Pad12)" "unconnected-(U3-Q5-Pad15)" "unconnected-(U3-Q6-Pad16)" "unconnected-(U3-Q7-Pad19)" /MB0
    /MB1 /MB2 /MB3 /MB4 /MB5 /MB6 /MB7 /MB8
    /MB9 /MB10 /MB11 /MB12 /MB13 /MB14 /MB15 /MB16
    /MB17 "Net-(U38-I0b)" "/FLAG_LINK_INIT" "/FLAG_AC_SIGN" "Net-(U38-I0c)" "unconnected-(U6-Q5-Pad15)" "unconnected-(U6-Q6-Pad16)" "unconnected-(U6-Q7-Pad19)"
    "/*SHIFT_OUT" "Net-(U16-Za)" "unconnected-(U16-Zb-Pad9)" /AO0 /AO1 /AO2 /AO3 "unconnected-(U17-OVR-Pad13)"
    "Net-(U17-Cout)" "Net-(U17-Cn)" /AO4 /AO5 /AO6 /AO7 "unconnected-(U18-OVR-Pad13)" "Net-(U18-Cout)"
    /AO8 /AO9 /AO10 /AO11 "unconnected-(U19-OVR-Pad13)" "Net-(U19-Cout)" /AO12 /AO13
    /AO14 /AO15 "unconnected-(U20-OVR-Pad13)" "Net-(U20-Cout)" /AO16 /AO17 "/ARITH_CARRY_OUT" "unconnected-(U21-F3-Pad12)"
    "unconnected-(U21-OVR-Pad13)" "unconnected-(U21-Cout-Pad14)" /AR1 /AR0 "Net-(U22-C0)" "Net-(U22-C4)" /AR3 /AR2
    /AR5 /AR4 "Net-(U23-C4)" /AR7 /AR6 /AR9 /AR8 "Net-(U24-C4)"
    /AR11 /AR10 /AR13 /AR12 "Net-(U25-C4)" /AR15 /AR14 /AR17
    /AR16 "unconnected-(U26-C4-Pad9)" "unconnected-(U26-S4-Pad10)" "unconnected-(U26-S3-Pad13)" "/*ARITH_OUT" "Net-(U27-I0b)" "unconnected-(U29-O3b-Pad3)" "unconnected-(U29-O2b-Pad5)"
    "unconnected-(U29-O1b-Pad7)" "unconnected-(U29-O0b-Pad9)" "unconnected-(U29-O3a-Pad12)" "unconnected-(U29-O2a-Pad14)" "Net-(U30-Pad3)" "Net-(U30-Pad4)" "Net-(U30-Pad6)" "Net-(U30-Pad8)"
    "unconnected-(U30-Pad11)" "Net-(U31-Pad2)" "Net-(U31-Pad6)" "Net-(U31-Pad8)" "Net-(U31-Pad11)" "Net-(U31-Pad13)" "Net-(U32-Pad4)" "Net-(U34-I2a)"
    "Net-(U32-Pad11)" "Net-(U32-Pad12)" "Net-(U34-I1a)" "Net-(U33-Pad12)" "unconnected-(U34-Zb-Pad9)" "Net-(U35-Pad6)" "Net-(U35-Pad8)" "Net-(U35-Pad12)"
    "Net-(U36-Pad6)" "Net-(U36-Pad8)" "Net-(U36-Pad12)" "Net-(U37-Pad11)" "/FLAG_ZERO" "Net-(U37-Pad10)" "/CTL_CONST" "unconnected-(U38-Za-Pad4)"
    "/*SELECT_ALU" "unconnected-(J1-Pin_b2-Padb2)" "/STEP_ZERO" "/BUS_SELECT0" "/BUS_SELECT1" "/BUS_SELECT2" "/*SELECT_AC" "/*SELECT_STEP"
    "/*SELECT_MQ" "/*SELECT_CROSS" "/*SELECT_CORE" "/*SELECT_SWR" "/*SELECT_EXTRN" "/*IOT_PULSE" "/*DRQ_GRANT" "/REQ_ADDR"
    "/*JMP_I_DETECT" "/*INT_DETECT" "/*READ_IN_PULSE" /HALT "/ADDR_MODE0" "/ADDR_MODE1" /EXTRA0 "unconnected-(J1-Pin_b31-Padb31)"
    "unconnected-(J2-Pin_b2-Padb2)" /A0 /A1 /A2 /A3 /A4 /A5 /A6
    /A7 /A8 /A9 /A10 /A11 /A12 /A13 /A14
    /SC0 /SC1 /SC2 /SC3 /SC4 /SC5 /EXTRA2 /EXTRA4
    /EXTRA6 "/NEXT_BANK1" "/MA_AUTO_INX" /FP1 /FP3 "unconnected-(J2-Pin_b31-Padb31)" "Net-(U10-OEa)"
    (clearance_class "kicad_default")
    (via_rule kicad_default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class Power
    +5V GND
    (clearance_class Power)
    (via_rule Power)
    (rule
      (width 500.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)