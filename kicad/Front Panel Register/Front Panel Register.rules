    "unconnected-(SW6-C-Pad3)" "unconnected-(SW7-C-Pad3)" "unconnected-(SW8-C-Pad3)" "unconnected-(SW9-C-Pad3)" "unconnected-(SW10-C-Pad3)" "unconnected-(SW11-C-Pad3)" "unconnected-(SW12-C-Pad3)" "unconnected-(SW13-C-Pad3)"
    "unconnected-(SW14-C-Pad3)" "unconnected-(SW15-C-Pad3)" "unconnected-(SW16-C-Pad3)" "unconnected-(SW17-C-Pad3)" "unconnected-(SW18-C-Pad3)" "unconnected-(U3-O3b-Pad3)" "unconnected-(U3-O2b-Pad5)" "unconnected-(U3-O1b-Pad7)"
